# Nhà cung cấp AI trong pipeline:
#   none      — chỉ lọc từ khoá (mặc định trên GitHub Actions; Claude bổ sung phiếu lúc 08:31)
#   ollama    — AI chạy trên máy (miễn phí, cần cài Ollama)
#   anthropic — Claude API (cần ANTHROPIC_API_KEY)
AI_PROVIDER="none"

OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:14b"
OLLAMA_NUM_CTX=16384

ANTHROPIC_API_KEY=""
AI_TRIAGE_MODEL="claude-haiku-5-5"
AI_LEGAL_MODEL="claude-sonnet-5-5"

MAX_LEGAL_DEEP=15
ENABLE_PLAYWRIGHT="false"
